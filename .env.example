# GEMINI_API_KEY: Required for Gemini AI API calls (Resume parsing, ATS analysis, Recommendation rankings).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# MongoDB Atlas Connection URI (e.g. mongodb+srv://<username>:<password>@cluster0.mongodb.net/swipex?retryWrites=true&w=majority)
MONGODB_URI=

# Server configuration
NODE_ENV=development
PORT=3000
JWT_SECRET=

# AI Mode: 'gemini' (default, live LLM via Google GenAI) or 'mock' (local fallback heuristics)
AI_MODE=gemini
